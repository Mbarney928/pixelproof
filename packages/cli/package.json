{
  "name": "@pixelproof/cli",
  "version": "0.1.0",
  "description": "Capture, compare and approve screenshots of Storybook stories or pages across viewports and themes.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "pixelproof": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "commander": "15.1.0",
    "playwright": "1.65.0"
  }
}
