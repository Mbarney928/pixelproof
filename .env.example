# pixelproof needs no secrets. These optional overrides take precedence over pixelproof.config.json.

# Where the pages or Storybook under test are served (relative target URLs resolve against it).
PIXELPROOF_BASE_URL=http://127.0.0.1:6006
# Where baselines, captures and the report are stored.
PIXELPROOF_DIR=.pixelproof
# Browser pages captured in parallel (1-16).
PIXELPROOF_CONCURRENCY=4

# Review app only: sub-path the build is served from (for example /pixelproof/ on GitHub Pages).
BASE_PATH=./
